<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified App Links: https://zidrun.com/* opens the app directly.
                 Requires /.well-known/assetlinks.json hosted on the domain with this
                 app's signing-cert SHA-256 (see docs/MOBILE_ANDROID.md). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zidrun.com" />
                <data android:scheme="https" android:host="www.zidrun.com" />
            </intent-filter>

            <!-- Custom scheme for native callbacks (e.g. Google OAuth return): zidrun://... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zidrun" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- @capacitor-community/background-geolocation's own manifest declares this service
             exported="true" with no permission guard, so any other installed app could start/bind
             it. It's only ever started by this app's own Capacitor bridge (same process), which
             doesn't need exported="true" — override it closed. -->
        <service
            android:name="com.equimaps.capacitor_background_geolocation.BackgroundGeolocationService"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported" />

        <!-- @capgo/capacitor-social-login hard-depends on the Facebook Login SDK even though this
             app only ever calls it with provider "google" (see google-sign-in-button.tsx) — Facebook
             sign-in is never used. CustomTabActivity is the one Facebook component that ships
             exported with a BROWSABLE intent-filter (an OAuth-redirect catcher); remove it since
             nothing in the app can trigger the flow that would use it. -->
        <activity
            android:name="com.facebook.CustomTabActivity"
            tools:node="remove" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GPS run tracking. We deliberately do NOT request ACCESS_BACKGROUND_LOCATION
         ("Allow all the time") — Android 12+/16 flags it as a privacy risk. Instead the
         run is recorded by a foreground service (the background-geolocation plugin's
         persistent notification), which keeps reading GPS with the screen off using only
         "While using the app" location, since the service always starts while the app is open. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ask Android to keep recording GPS with the screen off (Doze exemption). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Step counter for run cadence (steps/min) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <!-- Voice input for the AI coach (paid subscribers) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
