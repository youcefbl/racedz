zidrun.com, www.zidrun.com {
	encode zstd gzip

	# Coach payment proofs are financial PII (BaridiMob/CCP screenshots). They live in the same
	# uploads volume but must NEVER be served publicly — only the app's authenticated route
	# /api/coach/subscription/proof/* serves them, to the owner or an admin. This block comes first
	# so it wins over the general /uploads/* handler below.
	#
	# Android App Links / Play signing verification (PR-048): no Caddy handling needed here.
	# `public/.well-known/assetlinks.json` is committed to the repo and Next.js serves everything
	# under public/ at the site root automatically, so it falls through to the `reverse_proxy`
	# below like any other static asset. An earlier version of this file served it from the
	# uploads volume instead "so it can be updated without rebuilding the app image" — but that
	# volume is empty on any fresh deploy (nothing ever populated it, and deploy.sh had no step
	# to), and this `handle` block is terminal: on a fresh volume it 404s and never falls through
	# to the app's own bundled copy, so App Links verification silently fails on any deploy that
	# didn't inherit a hand-seeded volume from a previous host (review round 3, P1). The bundled
	# copy has no such failure mode — it ships with the image on every deploy — at the cost of
	# needing a redeploy (not a hot volume edit) to change it, which is the correct tradeoff: a
	# signing-cert change belongs in a reviewed commit, not a one-off write to a running host.

	handle /uploads/coach-payment/* {
		respond 403
	}

	# Cloud-TTS cue audio cache. Not sensitive by content (allowlisted coaching phrases only), but
	# it is provider-generated media that only the authenticated /api/coach/tts route should serve.
	handle /uploads/tts-cache/* {
		respond 403
	}

	# Legacy TTS cache location (pre-allowlist). Files written here before the tts-cache move could
	# contain ARBITRARY user text synthesized by the old endpoint, so the deny matters even more
	# than for tts-cache; scripts/purge-tts-audio-cache.ts deletes the directory on deploy, and
	# this block guarantees nothing lingering is ever public.
	handle /uploads/tts-audio/* {
		respond 403
	}

	# Race-registration payment proofs (BaridiMob/CCP screenshots) are the same class of
	# financial PII as coach-payment above. Only the authenticated /api/registrations/[id]/proof
	# route (owner, an admin, or an organizer member of the race's organization) may read them.
	handle /uploads/payment/* {
		respond 403
	}

	# User uploads are written to a runtime volume by the app and served straight
	# from disk here (next start won't serve runtime-written public/ files).
	# handle_path strips the /uploads prefix, so /uploads/avatar/x.jpg maps to
	# /srv/uploads/avatar/x.jpg.
	handle_path /uploads/* {
		root * /srv/uploads
		# User-supplied content served straight from disk. Even though uploads are
		# validated by magic bytes on write, harden the response so a stored file can
		# never be sniffed into an executable type or run script/plugins in the origin:
		#   - nosniff pins the declared Content-Type (no MIME sniffing)
		#   - the sandbox CSP strips scripts, forms, and same-origin privileges
		#   - deny framing to block clickjacking via an uploaded page
		header {
			X-Content-Type-Options "nosniff"
			Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
			X-Frame-Options "DENY"
			Cache-Control "public, max-age=31536000, immutable"
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		}
		file_server
	}

	# Public Android app download. Served from a subfolder of the same uploads volume
	# (so the ~7 MB APK stays out of git and the Docker image) with the correct Android
	# package MIME type so phones install it directly. handle_path strips the prefix, so
	# /app/downloads/zidrunapk.apk maps to /srv/uploads/app-downloads/zidrunapk.apk.
	handle_path /app/downloads/* {
		root * /srv/uploads/app-downloads
		header {
			Content-Type "application/vnd.android.package-archive"
			Content-Disposition "attachment; filename=\"zidrunapk.apk\""
			# Short cache so a re-uploaded APK propagates within the hour.
			Cache-Control "public, max-age=3600"
		}
		file_server
	}

	# Everything else goes to the Next.js app.
	handle {
		reverse_proxy app:3003
	}
}
