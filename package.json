{
  "name": "racedz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3003",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3003",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "HOSTNAME=127.0.0.1 PORT=3003 node .next/standalone/server.js",
    "start:docker": "HOSTNAME=0.0.0.0 PORT=3003 node .next/standalone/server.js",
    "lint": "eslint . && npm run check:i18n",
    "check:i18n": "tsx scripts/check-i18n-parity.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "test:coach": "tsx scripts/test-coach.ts && tsx scripts/test-coach-context.ts && tsx scripts/test-adaptive-planner.ts && tsx scripts/test-coach-memory.ts",
    "test:workout": "tsx scripts/test-workout-structure.ts",
    "test:audio": "tsx scripts/test-audio-coaching.ts",
    "test:run-incident": "tsx scripts/test-run-incident.ts",
    "test:run-stats": "tsx scripts/test-run-stats.ts",
    "test:social-import": "tsx scripts/test-social-import.ts",
    "test:mfa": "tsx scripts/test-mfa.ts",
    "test:registration": "NODE_OPTIONS=\"--require ./scripts/_stubs/stub-server-only.cjs\" tsx scripts/test-registration-concurrency.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
    "test:e2e:visual": "node scripts/run-e2e.mjs tests/visual.e2e.spec.ts",
    "test:e2e:coach": "node scripts/run-e2e.mjs coach.e2e.spec.ts",
    "test:all": "npm run lint && npm run typecheck && npm run test:coach && npm run test:workout && npm run test:audio && npm run test:run-incident && npm run test:run-stats && npm run test:social-import && npm run test:mfa && npm run test:e2e",
    "audit:prune": "tsx scripts/prune-admin-audit.ts",
    "analytics:prune": "tsx scripts/prune-pageviews.ts",
    "client-errors:prune": "tsx scripts/prune-client-errors.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:tips": "tsx scripts/seed-coach-tips.ts",
    "import:races": "tsx scripts/import-coursealgerie.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "cap:sync": "node scripts/run-capacitor.cjs sync android",
    "cap:open": "node scripts/run-capacitor.cjs open android",
    "android:run": "node scripts/run-capacitor.cjs run android",
    "android:dev": "CAP_SERVER_URL=http://10.0.2.2:3003 node scripts/run-capacitor.cjs run android",
    "icons:gen": "node scripts/gen-icons.mjs",
    "icons:android": "node scripts/gen-android-icons.mjs",
    "splash:gen": "node scripts/gen-splash.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-community/text-to-speech": "^5.1.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@capgo/capacitor-social-login": "^6.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@prisma/client": "^5.21.1",
    "@sentry/nextjs": "^10.68.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^10.9.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "openai": "^6.44.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.61.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.23",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "tar": "7.5.21",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
