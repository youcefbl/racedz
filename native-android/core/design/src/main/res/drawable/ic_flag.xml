<?xml version="1.0" encoding="utf-8"?>
<!--
  Lucide "flag" (v0.468), the Races tab glyph.

  Replaces calendar-search: a race is a start line, not a database query, and at 24dp in a tab bar
  the magnifier read as "search" rather than "events". Same stroke convention as ic_flame.xml.

  This deliberately diverges from the website's Races glyph — see ShellTabSpec for why.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:pathData="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="2"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <path
      android:pathData="M4 22v-7"
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="2"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
</vector>
