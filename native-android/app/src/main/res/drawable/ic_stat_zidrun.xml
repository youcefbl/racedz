<!--
  Status-bar icon for push notifications.

  Android renders a notification's small icon as a SILHOUETTE: every non-transparent pixel is
  painted the system's tint and all colour is discarded. So this is a single flat white path, not
  the brand mark — dropping in the launcher icon (which is what usually happens) produces a solid
  grey blob in the status bar. The shape is the ZidRun "Z" chevron, which survives being reduced to
  one colour at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,4h16l-3,4h-8l10,0l-3,4h-8l-4,0l3,-4h8l-10,0z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,16h16l-3,4h-16z" />
</vector>
