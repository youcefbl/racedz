<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Recording a run needs precise location while the app is in the foreground OR while a
      foreground service is running. ACCESS_BACKGROUND_LOCATION is deliberately NOT requested:
      it covers collecting location when the app is not in use at all, Play grades it far more
      harshly, and a foreground service with a visible ongoing notification covers screen-off and
      backgrounded recording without it. The Capacitor app made the same call — do not re-add it.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The ongoing "recording" notification; from API 33 this is a runtime permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- GPS is required to record; the app is still useful for races and account without it. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The hardware step counter, read only while a run is recording, to measure cadence and let the
      server tell running from riding. Requested alongside location on the start screen; declining it
      just means a run with no cadence (the server falls back to speed). Not required — a device with
      no step counter records fine without it.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- BLE heart-rate sensor (NATRUN-07.3). Runtime-requested from the sensor row only; scanning is
         declared as never used for location so Android does not gate it on the location permission
         on API 31+. Optional hardware: phones without BLE simply show "not supported". -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <!--
      Voice notes to the coach (COACHPAR-001). Requested at the moment the runner taps the mic, not
      at launch, and the recording is a cache file deleted as soon as it has been transcribed. The
      microphone is never opened by anything else in the app: there is no background listening, no
      wake word, and no ambient capture during a run.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      Custom Tabs needs to see whether a browser is installed. This <queries> entry is the minimum
      package visibility that allows it on API 30+; the app does not enumerate installed apps.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".ZidRunApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ZidRunNative.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ZidRunNative.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              OAuth redirect target for the system-browser sign-in. A custom scheme can be claimed
              by any app, which is precisely why the authorization code is bound to a PKCE verifier
              this app never transmitted (see core/auth/Pkce.kt) — an interceptor gets a code it
              cannot exchange.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zidrun" android:host="auth" />
            </intent-filter>

            <!--
              Race deep links. zidrun://race/<slug> is the scheme the app relies on for its own
              in-app links, unconditionally.

              The https filter is now autoVerify: the native app (dz.racedz.nativeapp) is the
              production mobile client (owner decision 2026-08-02, PRODUCT.md; Capacitor/
              dz.racedz.app is retired) and https://zidrun.com/.well-known/assetlinks.json lists
              both packages' certs, so Android's Digital Asset Links check passes for this one.
              Verification only affects apps that pass it — a plain browser tab is untouched
              either way — and with both certs listed, a device with only one of the two apps
              installed still opens straight into it with no chooser. Flipped at the same
              versionCode bump as the review-round-3 fixes, matching the intent recorded in
              EXECUTION_PLAN.md on 2026-08-20 ("flip in the next versionCode").
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zidrun" android:host="race" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zidrun.com" android:pathPrefix="/races/" />
            </intent-filter>
        </activity>

        <service
            android:name="dz.racedz.nativeapp.feature.runs.record.RunTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          Push receiver (NATGAP-03).

          `exported="false"` — only the Play Services messaging library may bind it; nothing else on
          the device has any business delivering us a push. The default icon/colour meta-data is
          what the system tray uses for a message the app never sees, which is the common case: the
          server sends a `notification` block, so a backgrounded app's notification is rendered
          entirely by the system without this process running at all.
        -->
        <service
            android:name=".push.ZidRunMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_zidrun" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="zidrun_general" />

        <!--
          Hands the account data export to a share target as a content:// URI.

          `exported="false"` with `grantUriPermissions` is the whole point: no other app can query
          this provider, and a share target only ever gets a one-shot, read-only grant for the exact
          file the runner chose to send. The authority is suffixed with the build's applicationId so
          the debug and release apps can be installed side by side — two providers claiming one
          authority makes the second install fail outright.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
