<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Custom Tabs needs to see whether a browser is installed. This <queries> entry is the minimum
      package visibility that allows it on API 30+; the app does not enumerate installed apps.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".ZidRunApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ZidRunNative.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ZidRunNative.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              OAuth redirect target for the system-browser sign-in. A custom scheme can be claimed
              by any app, which is precisely why the authorization code is bound to a PKCE verifier
              this app never transmitted (see core/auth/Pkce.kt) — an interceptor gets a code it
              cannot exchange.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zidrun" android:host="auth" />
            </intent-filter>

            <!--
              Race deep links. The https filter is NOT autoVerify: claiming zidrun.com would take
              those URLs away from the browser for every user of this evaluation build, and the
              production Capacitor app (dz.racedz.app) is the package that owns them. Until a
              release decision is made this opens via the chooser, and zidrun://race/<slug> is the
              scheme the app can rely on for its own links.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zidrun" android:host="race" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zidrun.com" android:pathPrefix="/races/" />
            </intent-filter>
        </activity>

    </application>

</manifest>
