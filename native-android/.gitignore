# Gradle / Android Studio build output and caches.
build/
.gradle/
.kotlin/
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Machine-specific SDK path — every developer's differs, and it is generated by Android Studio.
local.properties

# Signing material never belongs in the repository (see docs/NATIVE_ANDROID_OPTION_PLAN.md:
# no production keystore is to be copied into this project).
*.jks
*.keystore
keystore.properties

# Firebase config for the native app is not checked in; it is added per environment at build time.
google-services.json

# Tooling scratch files.
.impeccable/
